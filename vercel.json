{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(app|content-free|patterns|core|viz|anim|trace|auth|analytics|config).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/content.js": { "includeFiles": "{data.js,guides.js,patterns.js,core.js}" },
    "api/cron-reminders.js": { "includeFiles": "{data.js,guides.js,patterns.js,core.js}" }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "public"
}
